        "decode_note": "Reversible Windows-1252 candidate; original bytes retained"
      },
      "raw_text": "\nstress_impact - Adds stress to the character according to specified traits.\n\n<character> =\n\tstress_impact = {\n\t\tbase = value\t\t# base value that is always added, optional. Can be a scripted value.\n\t\ttrait = value\t\t# add this stress if the character has this trait. Does not support scripted values.\n\t\ttrait = value\t\t# multiple 'trait = value' lines are supported as long as each trait is only referenced once.\n\t}\n}\n\nValues are added together, so positive and negative additions will cancel each other.\nSupported Scopes: character\n\n",
      "line": 10919,
      "span_start": 10918,
      "span_end": 10931,
      "supported_scopes": [
        "character"
      ],
      "supported_targets": [],
      "parameter_documentation": [
        "stress_impact = {",
        "base = value\t\t# base value that is always added, optional. Can be a scripted value.",
        "trait = value\t\t# add this stress if the character has this trait. Does not support scripted values.",
        "trait = value\t\t# multiple 'trait = value' lines are supported as long as each trait is only referenced once."
      ]
    },
